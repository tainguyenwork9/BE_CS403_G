Project VehicleRental_BE {
  database_type: 'MySQL'
  Note: 'Schema cơ sở dữ liệu hệ thống cho thuê xe & thanh toán tự động qua VietQR'
}

Table tai_khoans {
  maTaiKhoan bigint [pk, increment, note: 'Khóa chính']
  tenDangNhap varchar(255) [unique, not null, note: 'Tên đăng nhập']
  matKhau varchar(255) [not null, note: 'Mật khẩu đã mã hóa']
  vaiTro varchar(255) [not null, default: 'khach_hang', note: 'Vai trò người dùng (khach_hang, nhan_vien, admin)']
  trangThai boolean [not null, default: true, note: 'Trạng thái hoạt động']
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table khach_hangs {
  maKhachHang bigint [pk, increment, note: 'Khóa chính']
  maTaiKhoan bigint [unique, not null, note: 'Liên kết 1-1 với tai_khoans']
  hoTen varchar(255) [not null, note: 'Họ và tên khách hàng']
  ngaySinh date [null, note: 'Ngày sinh']
  soDienThoai varchar(255) [null, note: 'Số điện thoại']
  email varchar(255) [null, note: 'Địa chỉ email']
  diaChi text [null, note: 'Địa chỉ cư trú']
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table ho_so_xac_thucs {
  maHoSo bigint [pk, increment, note: 'Khóa chính']
  maKhachHang bigint [not null, note: 'Liên kết với khach_hangs']
  soCCCD varchar(255) [null, note: 'Số căn cước công dân']
  anhCCCDMatTruoc varchar(255) [null, note: 'Đường dẫn ảnh CCCD mặt trước']
  anhCCCDMatSau varchar(255) [null, note: 'Đường dẫn ảnh CCCD mặt sau']
  soGPLX varchar(255) [null, note: 'Số giấy phép lái xe']
  anhGPLX varchar(255) [null, note: 'Đường dẫn ảnh GPLX']
  trangThai varchar(255) [not null, default: 'cho_duyet', note: 'Trạng thái xác thực (cho_duyet, da_duyet, tu_choi)']
  ngayGui timestamp [null, note: 'Thời điểm gửi hồ sơ']
  ngayXacThuc timestamp [null, note: 'Thời điểm xác thực hồ sơ']
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table xes {
  maXe bigint [pk, increment, note: 'Khóa chính']
  tenXe varchar(255) [not null, note: 'Tên xe']
  hangXe varchar(255) [not null, note: 'Hãng sản xuất']
  bienSo varchar(255) [unique, not null, note: 'Biển số xe']
  mauSac varchar(255) [not null, note: 'Màu sắc']
  namSanXuat year [not null, note: 'Năm sản xuất (cast integer)']
  giaThue double [not null, note: 'Giá thuê xe theo ngày']
  loaiXe varchar(255) [not null, note: 'Loại xe']
  tinhTrang varchar(255) [not null, default: 'san_sang', note: 'Tình trạng xe (san_sang, dang_thue, bao_tri, ...)']
  hinhAnh varchar(255) [null, note: 'Đường dẫn hình ảnh xe']
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table bookings {
  id bigint [pk, increment, note: 'Mã đơn đặt xe (BOOKING_ID)']
  user_id bigint [not null, note: 'Tài khoản đặt xe (liên kết tai_khoans.maTaiKhoan)']
  car_id bigint [not null, note: 'Xe được thuê (liên kết xes.maXe)']
  start_date datetime [not null, note: 'Thời gian bắt đầu thuê']
  end_date datetime [not null, note: 'Thời gian kết thúc thuê']
  options json [null, note: 'Các tùy chọn đi kèm khi thuê xe']
  total_amount double [not null, note: 'Tổng số tiền cần thanh toán (AMOUNT)']
  status varchar(50) [not null, default: 'PENDING_PAYMENT', note: 'Trạng thái đơn: PENDING_PAYMENT, PAID, CONFIRMED, IN_PROGRESS, COMPLETED, PAYMENT_MISMATCH, CANCELLED, EXPIRED']
  transfer_code varchar(100) [unique, not null, note: 'Mã nội dung chuyển khoản duy nhất (DESCRIPTION), VD: THUEXE_{id}']
  expires_at timestamp [null, note: 'Thời điểm hết hạn thanh toán (Countdown 15 phút)']
  ghi_chu text [null, note: 'Ghi chú hủy đơn / mức hoàn tiền dự kiến / ghi chú nhân viên vận hành']
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table payment_transactions {
  id bigint [pk, increment, note: 'Khóa chính giao dịch']
  booking_id bigint [null, note: 'Đơn đặt xe liên kết (bookings.id)']
  amount double [not null, note: 'Số tiền giao dịch thực tế nhận được']
  bank_trans_id varchar(255) [unique, not null, note: 'Mã giao dịch ngân hàng (chống trùng lặp webhook / Idempotency)']
  trans_description text [null, note: 'Nội dung chuyển khoản từ ngân hàng']
  status varchar(50) [not null, default: 'SUCCESS', note: 'Trạng thái giao dịch: SUCCESS, PAYMENT_MISMATCH, UNMATCHED']
  raw_payload json [null, note: 'Dữ liệu gốc từ cổng webhook (SePay/Casso)']
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table users {
  id bigint [pk, increment, note: 'Bảng user mặc định của Laravel']
  name varchar(255) [not null]
  email varchar(255) [unique, not null]
  email_verified_at timestamp [null]
  password varchar(255) [not null]
  remember_token varchar(100) [null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

// Quan hệ giữa các bảng (Relationships)
Ref: khach_hangs.maTaiKhoan - tai_khoans.maTaiKhoan [delete: cascade]
Ref: ho_so_xac_thucs.maKhachHang > khach_hangs.maKhachHang [delete: cascade]
Ref: bookings.user_id > tai_khoans.maTaiKhoan [delete: cascade]
Ref: bookings.car_id > xes.maXe [delete: cascade]
Ref: payment_transactions.booking_id > bookings.id [delete: set null]
